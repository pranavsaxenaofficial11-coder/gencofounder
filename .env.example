# ============================================================================
# GenCopilot — environment variables
#
# NEVER put real secrets in .env: that file is COMMITTED to this repo.
# Local secrets  -> .env.local   (matched by *.local in .gitignore)
# Production     -> Cloudflare dashboard > your Worker > Settings > Variables,
#                   added as ENCRYPTED secrets, not plaintext.
#
# Anything prefixed VITE_ is inlined into the browser bundle at build time and
# is therefore PUBLIC by design. Never prefix a secret with VITE_.
# ============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — the AI chat endpoint returns HTTP 500 without at least ONE of these
# functions/api/chat.js resolves them in this order:
#   NVIDIA_API_KEY, then (OPENROUTER_API_KEY | AI_API_KEY | ANTHROPIC_API_KEY)
# ─────────────────────────────────────────────────────────────────────────────
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
AI_API_KEY=
ANTHROPIC_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# STRONGLY RECOMMENDED — abuse / cost control
#
# ALLOWED_ORIGIN pins CORS. When unset, chat.js falls back to echoing the
# caller's own Origin header, which means ANY site can call your AI endpoint and
# spend your credits. Set it to your deployed origin, e.g.
#   https://gencopilot.pages.dev
# ─────────────────────────────────────────────────────────────────────────────
ALLOWED_ORIGIN=

# Server-side reCAPTCHA v3 secret. Both chat.js and contact.js SKIP verification
# entirely when this is absent ("fail open"), leaving those endpoints unguarded.
RECAPTCHA_SECRET_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — model overrides. Sensible defaults are hard-coded.
#   NVIDIA_MODEL default: z-ai/glm-5.2
#   AI_MODEL     default: claude-sonnet-4-6
# ─────────────────────────────────────────────────────────────────────────────
NVIDIA_MODEL=
AI_MODEL=


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Live Markets module (functions/api/market.js)
# Each is independent; a missing key just drops that data source.
# ─────────────────────────────────────────────────────────────────────────────
COINGECKO_KEY=   # crypto. Works keyless on the demo tier; key raises rate limits
FMP_KEY=         # Financial Modeling Prep — equities
FINNHUB_KEY=     # Finnhub — equities


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Industry News module (functions/api/news.js)
# Three tiers, tried in order. Tier 3 is a keyless RSS fallback, so this module
# still works with NO keys set at all.
# ─────────────────────────────────────────────────────────────────────────────
NEWS_API_KEY=    # tier 1 (newsdata.io)
GNEWS_API_KEY=   # tier 2 (gnews.io)


# ─────────────────────────────────────────────────────────────────────────────
# CLIENT-SIDE, PUBLIC (build-time inlined — safe to commit, no secrets here)
# ─────────────────────────────────────────────────────────────────────────────
VITE_AI_MODE=
VITE_NVIDIA_MODEL=
VITE_PUTER_MODEL=
VITE_DEV_AUTOLOGIN=   # local dev only: skips auth. Leave unset in production.

# App Check. REQUIRED whenever enforcement is ON for Authentication (Firebase
# Console > Build > App Check > APIs). Without it, every sign-in AND the
# automatic anonymous guest session fail with
# auth/firebase-app-check-token-is-invalid.
#
# This is the reCAPTCHA v3 SITE key registered under App Check > Apps. Public by
# design (it ships in the bundle); the reCAPTCHA SECRET key never goes here.
VITE_APPCHECK_SITE_KEY=

# Localhost only. App Check rejects requests from unregistered origins, so dev
# needs a debug token: leave this blank on first run, copy the token the browser
# console prints, register it under App Check > Apps > Manage debug tokens, then
# paste it here so it stays stable across reloads. Never set in production.
VITE_APPCHECK_DEBUG_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# BUSINESS EMAIL — Microsoft 365 (Entra ID). Setup: MICROSOFT_SETUP.md
#
# Both values are PUBLIC by design. A client ID identifies an app registration;
# it is not a credential. The sign-in flow is authorization code + PKCE, which
# needs no client secret — so there is no secret to leak here. If a setup guide
# ever tells you to put a client SECRET in a browser app, it is wrong.
#
# Without VITE_MS_CLIENT_ID the Business Email module renders a setup card and
# the rest of the app is unaffected.
# ─────────────────────────────────────────────────────────────────────────────

# Application (client) ID from Entra ID > App registrations > your app.
VITE_MS_CLIENT_ID=

# Who may sign in. Defaults to "organizations" (any work/school account).
#   organizations  — any Microsoft 365 / Entra work or school account
#   <tenant GUID>  — only your own organization
#   common         — also allows personal outlook.com accounts
VITE_MS_TENANT_ID=
