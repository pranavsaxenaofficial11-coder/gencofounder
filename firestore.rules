rules_version = '2';
// ============================================================================
// GenCopilot Firestore security rules
// Deploy: Firebase Console -> Firestore Database -> Rules -> paste -> Publish
// (project: gencopilot-78024)
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // --- User profiles + their notifications -------------------------------
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid);
      allow delete: if false;

      match /notifications/{noteId} {
        allow read, update, delete: if isOwner(uid);
        // any signed-in user may notify another (DMs, comments)
        allow create: if signedIn();
      }
    }

    // --- Company workspace: private to the founder --------------------------
    // Covers companies/{uid} and every subcollection the app uses:
    // tasks, meetings, leads, feedback, clients, investors, automations,
    // metrics, chats, and any future per-company collection.
    match /companies/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // --- Community: world-readable for members, authors own their posts -----
    match /community_posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      // likes[] and commentCount are updated by any member; deletes are author-only
      allow update: if signedIn();
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
        allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      }
    }

    // --- Talent directory: public profiles, self-managed --------------------
    match /public_profiles/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner(uid);
    }

    // --- Direct messages: participants only ---------------------------------
    match /conversations/{convoId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create, update: if signedIn() && request.auth.uid in request.resource.data.participants;

      match /messages/{msgId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
        allow create: if signedIn() && request.resource.data.fromId == request.auth.uid;
      }
    }

    // --- Contact form: anyone may submit, nobody may read from the client ---
    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
