rules_version = '2';
// GenCopilot Firestore security rules
// Deploy: Firebase Console -> Firestore Database ->
// Rules -> paste -> Publish (project gencopilot-78024)
//
// Lines are deliberately short and ASCII-only. The console
// mangles long lines on paste, which is what produces the
// "Unexpected 'function'" class of parse errors. Document
// paths are built with path() + concatenation so that no
// single line ever carries a full path.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- identity -------------------------------------
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---- path builders --------------------------------
    function orgPath(o) {
      return path('/databases/' + database +
        '/documents/orgs/' + o);
    }
    function memberPath(o, u) {
      return path('/databases/' + database +
        '/documents/orgs/' + o + '/members/' + u);
    }
    function invitePath(c) {
      return path('/databases/' + database +
        '/documents/org_invites/' + c);
    }
    function convoPath(c) {
      return path('/databases/' + database +
        '/documents/conversations/' + c);
    }

    // ---- workspace helpers ----------------------------
    // A workspace id IS its founder's uid (ensureOrg in
    // src/org.js), so the common case is answered without
    // reading a document. The get() is the fallback and is
    // only reached for members, which keeps it off the
    // owner's hot path.
    function isOrgOwner(o) {
      return signedIn() && (
        request.auth.uid == o ||
        get(orgPath(o)).data.ownerUid == request.auth.uid
      );
    }
    function isOrgMember(o) {
      return signedIn() &&
        exists(memberPath(o, request.auth.uid));
    }
    function isConvoParticipant(cid) {
      return request.auth.uid in
        get(convoPath(cid)).data.participants;
    }

    // ---- users + notifications ------------------------
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid);
      allow delete: if false;

      match /notifications/{noteId} {
        allow read, update, delete: if isOwner(uid);
        allow create: if signedIn();
      }
    }

    // ---- company workspace: private to the founder ----
    // Covers companies/{uid} and every subcollection:
    // tasks, meetings, leads, feedback, clients,
    // investors, automations, metrics, chats, etc.
    match /companies/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // ---- shared team workspace ------------------------
    // What a founder and their teammates need to see about
    // each other: the roster, the AI cost ledger and the
    // price card. Deliberately separate from
    // companies/{uid}, which stays owner-only.
    match /orgs/{orgId} {
      allow read: if isOrgOwner(orgId)
        || isOrgMember(orgId);
      // A workspace is created by, and named after, its
      // founder.
      allow create: if signedIn()
        && orgId == request.auth.uid
        && request.resource.data.ownerUid
             == request.auth.uid;
      allow update: if isOrgOwner(orgId);
      allow delete: if false;

      // ---- roster ------------------------------------
      match /members/{memberId} {
        allow read: if isOrgOwner(orgId)
          || isOrgMember(orgId);

        // The founder administers everyone.
        allow create, update, delete: if isOrgOwner(orgId);

        // Self-join. The invite code is the secret, and it
        // is verified here rather than trusted from the
        // client: the code must resolve to THIS workspace,
        // the row must be the joiner's own, and the role
        // is pinned to Team Member so nobody can promote
        // themselves on the way in.
        allow create: if signedIn()
          && memberId == request.auth.uid
          && request.resource.data.uid
               == request.auth.uid
          && request.resource.data.role == 'Team Member'
          && exists(
               invitePath(request.resource.data.joinCode)
             )
          && get(
               invitePath(request.resource.data.joinCode)
             ).data.orgId == orgId;

        // A member may maintain their own record (phone,
        // linked mailbox) but cannot change their role.
        allow update: if signedIn()
          && memberId == request.auth.uid
          && request.resource.data.role
               == resource.data.role;
      }

      // ---- AI cost ledger ----------------------------
      // Append-only: rows are written once and never
      // edited or deleted, so a bill cannot be quietly
      // rewritten after the fact. The founder reads
      // everything; a teammate reads only their own rows.
      match /usage/{entryId} {
        allow read: if isOrgOwner(orgId)
          || (isOrgMember(orgId)
              && resource.data.uid == request.auth.uid);
        allow create: if isOrgMember(orgId)
          && request.resource.data.uid
               == request.auth.uid;
        allow update, delete: if false;
      }

      // ---- price card --------------------------------
      match /settings/{docId} {
        allow read: if isOrgOwner(orgId)
          || isOrgMember(orgId);
        allow write: if isOrgOwner(orgId);
      }
    }

    // ---- invite codes ---------------------------------
    // Readable by any signed-in user, because someone
    // joining a workspace has no access to it yet and this
    // is how they resolve a code to a workspace. It holds
    // no secrets: only the id and name of the workspace
    // the code opens, and possession of the code is the
    // thing being checked.
    match /org_invites/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid
             == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    // ---- community: members read, authors own posts ---
    match /community_posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId
             == request.auth.uid;
      allow update: if signedIn();
      allow delete: if signedIn()
        && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorId
               == request.auth.uid;
        allow delete: if signedIn()
          && resource.data.authorId
               == request.auth.uid;
      }
    }

    // ---- talent directory: public, self-managed -------
    match /public_profiles/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner(uid);
    }

    // ---- direct messages: participants only -----------
    match /conversations/{convoId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participants;
      allow create, update: if signedIn()
        && request.auth.uid
             in request.resource.data.participants;

      match /messages/{msgId} {
        allow read: if signedIn()
          && isConvoParticipant(convoId);
        allow create: if signedIn()
          && request.resource.data.fromId
               == request.auth.uid;
      }
    }

    // ---- contact form: submit only, no client reads ---
    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
