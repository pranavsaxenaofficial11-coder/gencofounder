# ============================================================================
# GenCopilot — AI provider config (Vite picks this up on `npm run build`)
# ============================================================================
# Switch the AI backend by editing VITE_AI_MODE. Only ONE mode is active per
# build. Rebuild + redeploy after changing it.
#
#   VITE_AI_MODE=puter   → Puter.js (client-side, free, user-pays model).
#                          No API key needed. Each user signs into Puter and
#                          covers their own AI usage. Good for broad usage.
#
#   VITE_AI_MODE=nvidia  → NVIDIA NIM serverless endpoint, proxied through
#                          /api/chat. Requires NVIDIA_API_KEY (see .dev.vars
#                          locally and Cloudflare Pages → Settings → Variables
#                          in production). Good when you want to pay for usage
#                          centrally / lower user friction.
# ============================================================================

VITE_AI_MODE=nvidia

# Model used by Puter.js (client-side). Pick any model from the Puter catalog,
# e.g. gpt-5.4-nano, claude-sonnet-4-6, gemini-3.1-flash-lite.
VITE_PUTER_MODEL=gpt-5.4-nano

# Model used by NVIDIA NIM via the /api/chat proxy. See
# https://build.nvidia.com for the current free-endpoint catalog.
VITE_NVIDIA_MODEL=z-ai/glm-5.2
